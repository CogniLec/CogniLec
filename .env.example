# LIS Environment Variables Template
# Copy to .env and fill in values
# NEVER commit .env to version control

# =============================================================================
# Domain & TLS
# =============================================================================
# lis.local is LAN-only (no public DNS, no valid TLS). For a real public
# deployment, set this to a domain you actually own and point its A/AAAA
# record at this machine's public IP -- see docs/deploy-public.md.
DOMAIN=lis.local
# Required by Let's Encrypt (expiry notices, rate-limit contact) -- use a
# real inbox you control, not admin@lis.local, once DOMAIN is public.
TRAEFIK_EMAIL=admin@lis.local

# Client (src/client) production build, served via nginx -- see the
# `client` service in docker-compose.yml. VITE_API_BASE_URL is baked in at
# BUILD time (Vite env vars are compile-time), so changing it needs
# `docker compose build client`, not just a restart. CLIENT_PORT is the
# host-side port if you want to reach it directly without going through
# Traefik/DNS (http://localhost:8081 by default).
#
# Public deployment: use https://api.${DOMAIN} instead (routed to the
# host's uvicorn API via docker/traefik/dynamic.yml) -- a plain http://
# URL here breaks once the client is served over https, since browsers
# block HTTPS pages from calling an HTTP API (mixed content).
VITE_API_BASE_URL=http://localhost:8123
CLIENT_PORT=8081

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_USER=lis
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=lis_main
SYLLABUS_DB=lis_syllabus

# S11: discrete PG-SYLLABUS params for the postgres_fdw CREATE SERVER /
# CREATE USER MAPPING migration (container-network host/port, not the
# host-mapped SYLLABUS_DATABASE_URL port).
SYLLABUS_DB_HOST=pg-syllabus
SYLLABUS_DB_PORT=5432
SYLLABUS_DB_NAME=lis_syllabus
SYLLABUS_DB_USER=lis
SYLLABUS_DB_PASSWORD=lis_dev

# S11: dedicated read-only role for the FDW user mapping (T11.5).
SYLLABUS_FDW_USER=lis_fdw_reader
SYLLABUS_FDW_PASSWORD=lis_fdw_reader_dev

# gap #4 fix: the app's actual runtime DB connection uses `lis_app`
# (NOSUPERUSER NOBYPASSRLS, provisioned by migration c4d8e2a6f1b9), not the
# superuser `lis` role -- so RLS policies are genuinely Postgres-enforced,
# not just checked in application code. Migrations still run as `lis`
# (DATABASE_URL, unchanged) since they need real DDL rights.
DATABASE_URL=postgresql+asyncpg://lis:lis_dev@localhost:5434/lis_main
RLS_DATABASE_URL=postgresql+asyncpg://lis_app:lis_app_dev@localhost:5434/lis_main

# =============================================================================
# MinIO
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_secure_password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_secure_password
MINIO_SECURE=false

# =============================================================================
# Valkey (Redis)
# =============================================================================
VALKEY_PASSWORD=changeme_secure_password

# =============================================================================
# pgAdmin
# =============================================================================
PGADMIN_EMAIL=admin@lis.local
PGADMIN_PASSWORD=changeme_secure_password

# =============================================================================
# Label Studio
# =============================================================================
LABEL_STUDIO_USER=admin@lis.local
LABEL_STUDIO_PASSWORD=changeme_secure_password

# =============================================================================
# Application
# =============================================================================
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# MLflow
# =============================================================================
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

# =============================================================================
# DVC / Audio Corpus (S04)
# =============================================================================
DVC_REMOTE=s3://lis-eval
DVC_REMOTE_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=changeme_secure_password

# =============================================================================
# Hugging Face
# =============================================================================
HF_HOME=/models/huggingface
HF_HUB_ENABLE_HF_TRANSFER=1

# =============================================================================
# CUDA / GPU
# =============================================================================
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128,expandable_segments:True
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Per-stage GPU device index (gap #21) — only meaningful for the machine
# actually running that in-process worker; safe to leave at 0 on any
# single-GPU host. VLLM_GPU_DEVICE/DIARISATION_GPU_DEVICE below are for
# their own isolated containers, same idea. See docs/multi-gpu-setup.md —
# for genuinely separate GPU MACHINES (not multiple cards in one host), the
# real distribution knob is TEI_BASE_URL/VLLM_API_BASE/DIARISATION_SERVICE_URL
# pointing at each machine's LAN IP, not these device indices.
ASR_CUDA_DEVICE=0
EMBEDDING_CUDA_DEVICE=0
VLLM_GPU_DEVICE=0
DIARISATION_GPU_DEVICE=0

# S25: embedding service (TEI). Point at a remote machine's IP:port for a
# multi-machine deployment; falls back to local sentence-transformers if
# unreachable. TEI_IMAGE_TAG/TEI_PORT/TEI_GPU_DEVICE/TEI_MAX_BATCH_TOKENS
# only matter on the machine hosting it.
TEI_BASE_URL=http://tei:80
TEI_IMAGE_TAG=cpu-1.5
TEI_PORT=8090
# Only used if TEI_IMAGE_TAG points at a GPU build (docker-compose.yml's
# device reservation on the tei service) -- device index on this machine.
TEI_GPU_DEVICE=0
# Lower this (e.g. 2048) on a small-VRAM GPU -- 16384 OOMs a 4GB card
# (confirmed live, gap #31). Leave at the default elsewhere.
TEI_MAX_BATCH_TOKENS=16384

# =============================================================================
# Monitoring
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://traefik:4318/v1/traces
OTEL_SERVICE_NAME=lis
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# =============================================================================
# LLM Serving — S36 vLLM (Tier 1 local GPU)
# =============================================================================
VLLM_MODEL=microsoft/Phi-3-mini-3.8B-4bit
VLLM_QUANTIZATION=awq
VLLM_GPU_MEMORY_UTIL=0.85
VLLM_MAX_MODEL_LEN=4096
VLLM_PORT=8000
VLLM_MAX_CONCURRENT=4

# =============================================================================
# LLM Router — S37 LiteLLM five-tier failover ladder
# =============================================================================
LITELLM_CONFIG_PATH=config/litellm.yaml

# config/litellm.yaml resolves these via LiteLLM's os.environ/VAR_NAME
# substitution (same mechanism as the *_API_KEY vars below) instead of
# hardcoding a docker-compose-internal hostname. Defaults below are correct
# for a single-host deployment; for the 3-separate-machines topology
# (docs/multi-gpu-setup.md) set these to Machine B's real LAN IP instead of
# editing config/litellm.yaml by hand.
VLLM_API_BASE=http://vllm:8000/v1
LLAMACPP_API_BASE=http://llamacpp:8080/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
GROQ_API_KEY=
LLM_TIMEOUT_T1=60
LLM_TIMEOUT_T2=120
LLM_TIMEOUT_T3=30
LLM_TIMEOUT_T4=30

# =============================================================================
# Structured Output — S38 schema registry
# =============================================================================
SCHEMA_DIR=config/schemas/
OUTLINES_CACHE_DIR=/tmp/outlines_grammar
INSTRUCTOR_MAX_RETRIES=1
SCHEMA_VALIDATION_ENABLED=true

# =============================================================================
# Observability — S39 LangFuse tracing
# =============================================================================
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_DB_PASSWORD=changeme
LANGFUSE_NEXTAUTH_SECRET=changeme
LANGFUSE_SALT=changeme
TRACE_SAMPLE_RATE=1.0

# =============================================================================
# Prompt Versioning — S40
# =============================================================================
PROMPT_REGISTRY_BACKEND=filesystem
PROMPTFOO_API_KEY=
DEFAULT_MODEL=phi-3-mini-3.8b-4bit
DEFAULT_TEMPERATURE=0.7
