# LIS Client Capture PWA — environment variables (Vite convention)
# Copy to .env.local for local development.

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# Chunk duration in ms
VITE_CHUNK_DURATION_MS=30000

# Overlap between successive chunks, in ms
VITE_CHUNK_OVERLAP_MS=5000

# Max upload retry attempts before marking a chunk failed
VITE_MAX_UPLOAD_RETRIES=5

# Base backoff duration (ms) for exponential retry backoff
VITE_UPLOAD_RETRY_BASE_MS=1000
